    {
      "parameters": {
        "jsCode": "const raw = $input.item.json.output ?? $input.item.json.text ?? $input.item.json.content;\n\n// Parse the JSON string\nconst parsed = JSON.parse(raw);\n\n// Format visited_pages\nif (Array.isArray(parsed.visited_pages)) {\n  parsed.visited_pages = parsed.visited_pages\n    .map(page => {\n      if (page === \"/\") return \"Home\";\n\n      return page\n        .replace(/^\\//, \"\") // Remove leading /\n        .split(\"-\")\n        .map(word => word.charAt(0).toUpperCase() + word.slice(1))\n        .join(\" \");\n    })\n    .join(\"\\n\"); // Change to \", \" if you prefer a single line\n}\n\nreturn [{ json: parsed }];"
      },
